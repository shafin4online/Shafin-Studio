# App Configuration
VITE_APP_TITLE=shafinbdstudio
# Primary Google Gemini API Key
GEMINI_API_KEY=
# Centralized API Pool: comma-separated list of keys (e.g. key1,key2,key3...) or name:key (e.g. name1:key1,name2:key2)
GEMINI_API_KEYS=
# Optional JSON array of accounts for Vercel Environment Variables:
GEMINI_ACCOUNTS_JSON=
